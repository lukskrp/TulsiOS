# tulsi.daemon — tulsid, the privileged TulsiOS system daemon.
#
# Owns <flakeDir>/tulsi/state.json, serves the D-Bus API org.tulsi.Manager1,
# authorizes changes with polkit (action org.tulsi.apply), runs the rebuild
# command and records every successful change as a git commit in <flakeDir>.
#
# With `bootstrap.enable`, a system flake is generated in <flakeDir> on first
# start so the machine can rebuild itself from state.json.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.tulsi.daemon;

  daemonConfig = {
    flakeDir = cfg.flakeDir;
    rebuildCommand = cfg.rebuildCommand;
    initialState = if config.tulsi.state.enable then config.tulsi.state.file else null;
    polkit = true;
    packageIndex = cfg.packageIndex;
    allowUnfree = config.nixpkgs.config.allowUnfree or false;
  };

  flakeTemplate = pkgs.writeText "tulsi-system-flake.nix" ''
    # TulsiOS system flake, generated by tulsid on first boot.
    # Machine-managed choices live in ./tulsi/state.json (use `tulsi`, the
    # Software Center or the Assistant). Your own settings go in
    # ./configuration.nix. Every change is committed to git here.
    {
      inputs.tulsi.url = "path:${toString cfg.bootstrap.source}";

      outputs =
        { tulsi, ... }:
        {
          nixosConfigurations."${cfg.flakeHost}" = tulsi.inputs.nixpkgs.lib.nixosSystem {
            modules = [
              tulsi.nixosModules.default
              "''${tulsi}/${cfg.bootstrap.hostModule}"
              ./configuration.nix
              ({ lib, ... }: { tulsi.state.file = lib.mkForce ./tulsi/state.json; })
            ];
          };
        };
    }
  '';

  configurationTemplate = pkgs.writeText "tulsi-configuration.nix" ''
    # Your own NixOS settings. Edit freely; rebuild with
    #   sudo nixos-rebuild switch --flake ${cfg.flakeDir}#${cfg.flakeHost}
    { config, lib, pkgs, ... }:
    {
    }
  '';

  bootstrapScript = ''
    if [ ! -e ${cfg.flakeDir}/flake.nix ]; then
      echo "tulsid: generating system flake in ${cfg.flakeDir}"
      mkdir -p ${cfg.flakeDir}
      install -m 0644 ${flakeTemplate} ${cfg.flakeDir}/flake.nix
      if [ ! -e ${cfg.flakeDir}/configuration.nix ]; then
        install -m 0644 ${configurationTemplate} ${cfg.flakeDir}/configuration.nix
      fi
    fi
  '';
in
{
  options.tulsi.daemon = {
    enable = lib.mkEnableOption "tulsid, the TulsiOS system daemon";

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.callPackage ../packages/tulsi-tools.nix { };
      defaultText = lib.literalExpression "pkgs.callPackage ../packages/tulsi-tools.nix { }";
      description = "Package providing tulsid, tulsi and tulsi-mcp.";
    };

    flakeDir = lib.mkOption {
      type = lib.types.str;
      default = "/etc/nixos";
      description = "Directory of the system flake; tulsid keeps it under git.";
    };

    flakeHost = lib.mkOption {
      type = lib.types.str;
      default = config.networking.hostName;
      defaultText = lib.literalExpression "config.networking.hostName";
      description = "Name of the nixosConfigurations entry to rebuild.";
    };

    rebuildCommand = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "nixos-rebuild"
        "switch"
        "--flake"
        "${cfg.flakeDir}#${cfg.flakeHost}"
      ];
      defaultText = lib.literalExpression ''[ "nixos-rebuild" "switch" "--flake" "''${flakeDir}#''${flakeHost}" ]'';
      description = "Command tulsid runs (in flakeDir) after changing state.json.";
    };

    packageIndex = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      description = ''
        Package search index (JSON, see nix/packages/package-index.nix). Enables
        `Search` and instant rejection of unknown package names. The TulsiOS
        flake sets it to an index of the pinned nixpkgs.
      '';
    };

    wheelNoPassword = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Let members of `wheel` apply changes without entering a password.";
    };

    bootstrap = {
      enable = lib.mkEnableOption "generating a TulsiOS system flake in flakeDir on first start";

      source = lib.mkOption {
        type = lib.types.nullOr lib.types.path;
        default = null;
        description = "TulsiOS source tree the generated flake uses as its `tulsi` input. Set by the TulsiOS flake.";
      };

      hostModule = lib.mkOption {
        type = lib.types.str;
        example = "nix/hosts/vm";
        description = "Host module inside the TulsiOS source that the generated flake imports.";
      };
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = !cfg.bootstrap.enable || cfg.bootstrap.source != null;
        message = "tulsi.daemon.bootstrap.source must be set (use the TulsiOS flake's nixosModules.default).";
      }
    ];

    environment.systemPackages = [ cfg.package ];
    environment.etc."tulsi/tulsid.json".text = builtins.toJSON daemonConfig;

    services.dbus.packages = [ cfg.package ];
    security.polkit.enable = true;
    security.polkit.extraConfig = ''
      polkit.addRule(function (action, subject) {
        if (action.id.indexOf("org.tulsi.") !== 0) return polkit.Result.NOT_HANDLED;
        if (subject.user === "root") return polkit.Result.YES;
        ${lib.optionalString cfg.wheelNoPassword ''if (subject.isInGroup("wheel")) return polkit.Result.YES;''}
        return polkit.Result.NOT_HANDLED;
      });
    '';

    nix.settings.experimental-features = [
      "nix-command"
      "flakes"
    ];

    systemd.services.tulsid = {
      description = "TulsiOS system daemon";
      wantedBy = [ "multi-user.target" ];
      after = [
        "dbus.service"
        "polkit.service"
      ];
      path = [
        pkgs.git
        pkgs.coreutils
        pkgs.diffutils
        config.nix.package
        config.system.build.nixos-rebuild
      ];
      environment.HOME = "/root";
      preStart = lib.optionalString cfg.bootstrap.enable bootstrapScript;
      # A rebuild started by tulsid must not restart tulsid halfway through.
      # Daemon updates take effect after the next reboot or manual restart.
      restartIfChanged = false;
      serviceConfig = {
        Type = "dbus";
        BusName = "org.tulsi.Manager1";
        ExecStart = "${cfg.package}/bin/tulsid --config /etc/tulsi/tulsid.json";
        Restart = "on-failure";
      };
    };
  };
}
