[Desktop Entry]
Type=Service
MimeType=image/*;
Actions=resize;toJpg;toPng;toPdf;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Submenu=Convert

[Desktop Action resize]
Name=Resize Images…
Icon=image-x-generic
Exec=tulsi-file-tools resize %F

[Desktop Action toJpg]
Name=Convert to JPG
Icon=image-x-generic
Exec=tulsi-file-tools to-jpg %F

[Desktop Action toPng]
Name=Convert to PNG
Icon=image-x-generic
Exec=tulsi-file-tools to-png %F

[Desktop Action toPdf]
Name=Combine into a PDF
Icon=application-pdf
Exec=tulsi-file-tools images-to-pdf %F
