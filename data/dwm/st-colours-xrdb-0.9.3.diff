TulsiOS: st's colours from X resources, read when st starts: st.color0-15,
st.foreground, st.background, st.cursorColor (*.color0 and the like match),
so terminals opened after a theme switch (tulsi-theme, ADR 0021) take the
palette's colours. Only #rrggbb values are taken.

--- a/x.c	2026-11-25 13:22:40.005649573 +0200
+++ b/x.c	2026-11-25 13:22:40.010331317 +0200
@@ -10,6 +10,7 @@
 #include <libgen.h>
 #include <X11/Xatom.h>
 #include <X11/Xlib.h>
+#include <X11/Xresource.h>
 #include <X11/cursorfont.h>
 #include <X11/keysym.h>
 #include <X11/Xft/Xft.h>
@@ -1126,6 +1127,53 @@
 	return 1;
 }
 
+/* TulsiOS: the terminal colours from X resources, read when st starts:
+ * st.color0 .. st.color15, st.foreground, st.background, st.cursorColor
+ * (so *.color0 and the like match too), as a theme sets them (tulsi-theme,
+ * ADR 0021). Only "#rrggbb" values are taken: st exits on a colour it cannot
+ * allocate. */
+static int
+isrgb(const char *v)
+{
+	int i;
+
+	if (!v || strlen(v) != 7 || v[0] != '#')
+		return 0;
+	for (i = 1; i < 7; i++)
+		if (!((v[i] >= '0' && v[i] <= '9') || (v[i] >= 'a' && v[i] <= 'f') || (v[i] >= 'A' && v[i] <= 'F')))
+			return 0;
+	return 1;
+}
+
+static void
+xrdbcolours(void)
+{
+	static const char *special[] = { "foreground", "background", "cursorColor" };
+	char *rm, *type, name[32], class[32];
+	unsigned int index;
+	XrmDatabase db;
+	XrmValue value;
+	int i;
+
+	XrmInitialize();
+	if (!(rm = XResourceManagerString(xw.dpy)) || !(db = XrmGetStringDatabase(rm)))
+		return;
+	for (i = 0; i < 19; i++) {
+		if (i < 16) {
+			snprintf(name, sizeof(name), "st.color%d", i);
+			snprintf(class, sizeof(class), "St.Color%d", i);
+			index = i;
+		} else {
+			snprintf(name, sizeof(name), "st.%s", special[i - 16]);
+			snprintf(class, sizeof(class), "St.%s", special[i - 16]);
+			index = i == 16 ? defaultfg : i == 17 ? defaultbg : defaultcs;
+		}
+		if (XrmGetResource(db, name, class, &type, &value) && isrgb(value.addr))
+			colorname[index] = xstrdup(value.addr);
+	}
+	XrmDestroyDatabase(db);
+}
+
 void
 xinit(int cols, int rows)
 {
@@ -1149,6 +1197,7 @@
 
 	/* colors */
 	xw.cmap = XDefaultColormap(xw.dpy, xw.scr);
+	xrdbcolours();
 	xloadcols();
 
 	/* adjust fixed window geometry */
