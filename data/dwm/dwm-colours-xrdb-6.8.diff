+/* TulsiOS: the colours of config.h's `resources` from the X resource database
+ * (dwm.normbgcolor, ...), read from the root window each time, since Xlib's
+ * XResourceManagerString() keeps the copy it had when dwm started. Only
+ * "#rrggbb" values are taken: dwm exits on a colour it cannot allocate. */
+static int
+isrgb(const char *v)
+{
+	int i;
+
+	if (!v || strlen(v) != 7 || v[0] != '#')
+		return 0;
+	for (i = 1; i < 7; i++)
+		if (!((v[i] >= '0' && v[i] <= '9') || (v[i] >= 'a' && v[i] <= 'f') || (v[i] >= 'A' && v[i] <= 'F')))
+			return 0;
+	return 1;
+}
+
+void
+loadxrdb(void)
+{
+	Atom type;
+	int format;
+	unsigned long n, after;
+	unsigned char *data = NULL;
+	XrmDatabase db;
+	XrmValue value;
+	char *rtype;
+	size_t i;
+
+	if (XGetWindowProperty(dpy, root, resourcemanager, 0, 1L << 20, False, XA_STRING,
+	    &type, &format, &n, &after, &data) != Success || !data)
+		return;
+	if ((db = XrmGetStringDatabase((char *)data))) {
+		for (i = 0; i < LENGTH(resources); i++)
+			if (XrmGetResource(db, resources[i].name, resources[i].name, &rtype, &value)
+			    && isrgb(value.addr))
+				memcpy(resources[i].dst, value.addr, 8);
+		XrmDestroyDatabase(db);
+	}
+	XFree(data);
+}
+
+/* TulsiOS: new colours from the resources, on the bars, borders and tray. */
+void
+reloadcolours(void)
+{
+	Client *c;
+	Monitor *m;
+	size_t i;
+
+	loadxrdb();
+	for (i = 0; i < LENGTH(colors); i++) {
+		drw_scm_free(drw, scheme[i], 3);
+		scheme[i] = drw_scm_create(drw, colors[i], 3);
+	}
+	for (m = mons; m; m = m->next)
+		for (c = m->clients; c; c = c->next)
+			XSetWindowBorder(dpy, c->win,
+				scheme[c == selmon->sel ? SchemeSel : SchemeNorm][ColBorder].pixel);
+	if (systray) {
+		XSetWindowBackground(dpy, systray->win, scheme[SchemeNorm][ColBg].pixel);
+		updatesystray();
+	}
+	drawbars();
+}
