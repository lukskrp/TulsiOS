<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <!-- Changes ask every time (auth_admin, not _keep): a coding agent a person
       started in their terminal runs as them, and must not ride on an approval
       given minutes earlier for something else (ADR 0026). -->
  <vendor>TulsiOS</vendor>
  <action id="org.tulsi.apply">
    <description>Change the system configuration</description>
    <message>Authentication is required to install, remove or reconfigure software</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <!-- configuration.nix edits a NixOS rollback does not fully undo: accounts,
       boot, file systems, scripts and anything tulsid cannot place (ADR 0014).
       For people it is the same as org.tulsi.apply; Starah asks the human about
       it for agents below level 3. -->
  <action id="org.tulsi.configure">
    <description>Change the system configuration beyond what a rollback undoes</description>
    <message>Authentication is required to change accounts, boot or other lasting settings</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <!-- Moving to a newer TulsiOS release (ADR 0017). Undo takes it back, but it
       changes the whole system at once, so it is an action of its own. -->
  <action id="org.tulsi.upgrade">
    <description>Upgrade TulsiOS to a newer release</description>
    <message>Authentication is required to upgrade TulsiOS</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <!-- Changes that only add or remove browser extensions. The
       tulsi.browserExtensions module can allow this for active local users
       without a password (tulsi.browserExtensions.adopt.withoutPassword). -->
  <action id="org.tulsi.extensions">
    <description>Manage browser extensions declaratively</description>
    <message>Authentication is required to change system-wide browser extensions</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <!-- Keeping or undoing a change on trial after restarting (ADR 0029): the
       person at the computer confirms, or takes back, a change they already
       authorized; a black screen must not stand between them and Undo. -->
  <action id="org.tulsi.trial">
    <description>Keep or undo a change on trial</description>
    <message>Authentication is required to keep or undo a change on trial</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
